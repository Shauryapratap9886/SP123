# ==============================================================================
# Multilingual AI Voice Assistant - Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Preferred AI Provider: 'auto', 'gemini', 'openai', 'sarvam', or 'builtin'
# - auto: Automatically picks Gemini -> OpenAI -> Sarvam -> Built-in Engine
# - builtin: Runs entirely offline with zero external API calls
PREFERRED_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recommended: Generous free tier, fast multimodal vision)
# Get your free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. OpenAI API (GPT-4o-mini multimodal reasoning & whisper/TTS)
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Sarvam AI (Specialized Indian Languages: Hindi, Hinglish, Indic TTS/STT)
# Get your key at: https://www.sarvam.ai
# ------------------------------------------------------------------------------
SARVAM_API_KEY=
